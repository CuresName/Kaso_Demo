# 複製這個檔案為 .env，填入你自己的 key。.env 已在 .gitignore，不會進版控。
# 部署到 Railway 時，這些改用 Railway 專案的「Variables」設定，不要把 .env 上傳。

# --- Claude API（KASO AI 助手）---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 選填，預設 claude-sonnet-5。想省錢可改 claude-haiku-4-5-20251001。
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google（附近優惠）---
# 在 https://console.cloud.google.com/google/maps-apis 的同一個專案裡：
#   1. 啟用 "Places API (New)"（附近搜尋用，後端呼叫）
#   2. 啟用 "Maps JavaScript API"（地圖底圖用，前端呼叫）
#   3. 開 billing（有免費額度）
#
# 建議開兩把 key：
#   GOOGLE_PLACES_KEY        → 後端用，限制成「只能用 Places API (New)」，可加 IP 限制
#   GOOGLE_MAPS_BROWSER_KEY  → 前端用，限制成「只能用 Maps JavaScript API」+ HTTP referrer 限制到你的網域
# 只有一把 key 也能跑：兩個都留空時會 fallback 到 GOOGLE_MAPS_API_KEY。
GOOGLE_PLACES_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_API_KEY=

# --- 濫用防護（選填，有預設值）---
# /api/assistant/chat 全站每日呼叫上限
ASSISTANT_DAILY_LIMIT=200
# 單一 IP 在 ASSISTANT_WINDOW_MS 內對 /api/assistant/chat 的呼叫上限
ASSISTANT_IP_LIMIT=12
ASSISTANT_WINDOW_MS=600000

# Railway 會自動注入 PORT；本機不設就用 3000。
PORT=3000
